<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Engine.Editor.Animation.AnimationToolPanel">
    <DockPanel>

        <!-- ── Panel header ── -->
        <TextBlock DockPanel.Dock="Top"
                   Text="ANIMATION"
                   FontSize="10"
                   FontWeight="Bold"
                   Margin="6,6,6,4" />

        <!-- ── Clip browser ── -->
        <TextBlock DockPanel.Dock="Top"
                   Text="CLIPS"
                   FontSize="10"
                   Foreground="#888888"
                   Margin="6,0,6,2" />

        <ListBox DockPanel.Dock="Top"
                 x:Name="ClipBrowser"
                 MaxHeight="150"
                 Margin="4,0,4,4"
                 SelectionChanged="OnClipSelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" Padding="2,1" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Separator DockPanel.Dock="Top" Margin="0,0,0,2" />

        <!-- ══ Bottom section ══════════════════════════════════════════════════
             First Bottom item = lowest visually.  Last Bottom item = just above
             the FrameList fill element.
             Visual order top→bottom:
               FRAMES label + "+" → FrameList → PREVIEW → image → sep →
               TIMELINE → canvas → transport                                  -->

        <!-- Transport row — very bottom -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="4,4,4,4"
                    Spacing="2">
            <Button x:Name="BtnStepBack"    Content="⏮" Width="28" Height="24"
                    Padding="0" FontSize="11" Click="OnStepBack" />
            <Button x:Name="BtnPlay"        Content="▶" Width="28" Height="24"
                    Padding="0" FontSize="11" Click="OnPlay" />
            <Button x:Name="BtnPause"       Content="⏸" Width="28" Height="24"
                    Padding="0" FontSize="11" Click="OnPause" />
            <Button x:Name="BtnStop"        Content="⏹" Width="28" Height="24"
                    Padding="0" FontSize="11" Click="OnStop" />
            <Button x:Name="BtnStepForward" Content="⏭" Width="28" Height="24"
                    Padding="0" FontSize="11" Click="OnStepForward" />
        </StackPanel>

        <!-- Scrubber canvas — above transport.
             Right-click shows context menu; left-click / drag scrubs the playhead.
             Children are managed entirely in code-behind. -->
        <Canvas DockPanel.Dock="Bottom"
                x:Name="TimelineCanvas"
                Height="28"
                Background="#1a1a1a"
                Margin="4,0,4,2"
                ClipToBounds="True"
                PointerPressed="OnTimelinePointerPressed"
                PointerMoved="OnTimelinePointerMoved"
                PointerReleased="OnTimelinePointerReleased" />

        <!-- Timeline label — above canvas -->
        <TextBlock DockPanel.Dock="Bottom"
                   Text="TIMELINE"
                   FontSize="10"
                   Foreground="#888888"
                   Margin="6,4,6,2" />

        <Separator DockPanel.Dock="Bottom" Margin="0,2,0,0" />

        <!-- Live preview — 64×64 area, BitmapInterpolationMode=None for pixel-art -->
        <Border DockPanel.Dock="Bottom"
                Width="64"
                Height="64"
                Background="#111111"
                HorizontalAlignment="Center"
                Margin="4,0,4,4">
            <Image x:Name="PreviewImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="None" />
        </Border>

        <TextBlock DockPanel.Dock="Bottom"
                   Text="PREVIEW"
                   FontSize="10"
                   Foreground="#888888"
                   Margin="6,4,6,2" />

        <Separator DockPanel.Dock="Bottom" Margin="0,2,0,2" />

        <!-- FRAMES header + "+" button — last Bottom item, just above the frame list -->
        <DockPanel DockPanel.Dock="Bottom" Margin="6,2,4,2">
            <TextBlock Text="FRAMES"
                       FontSize="10"
                       Foreground="#888888"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Content="+"
                    Width="20" Height="18"
                    Padding="0" FontSize="12"
                    VerticalAlignment="Center"
                    Click="OnAddFrame" />
        </DockPanel>

        <!-- ── Frame list (fills remaining space) ──
             Each row shows a 40×40 thumbnail, the SpriteId label, a NumericUpDown
             for DurationMs (two-way bound, min 1 / max 10000), and a × remove button.
             PointerPressed on the row DockPanel starts a drag-to-reorder operation.
             DragDrop.AllowDrop and Drop are wired in code-behind. -->
        <ListBox x:Name="FrameList"
                 MinHeight="60"
                 Margin="4,0,4,4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Background="Transparent" ensures the empty area is hit-testable
                         for pointer-drag tracking. -->
                    <DockPanel Height="46" Margin="2,1"
                               Tag="{Binding}"
                               Background="Transparent"
                               PointerPressed="OnFrameRowPointerPressed">

                        <!-- Thumbnail — 40×40 display box -->
                        <Border DockPanel.Dock="Left"
                                Width="40" Height="40"
                                Background="#111111"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <Image Source="{Binding Thumbnail}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapInterpolationMode="None" />
                        </Border>

                        <!-- Remove button — far right; disabled when it is the only frame -->
                        <Button DockPanel.Dock="Right"
                                Content="×"
                                Tag="{Binding}"
                                Width="20" Height="20"
                                Padding="0" FontSize="12"
                                VerticalAlignment="Center"
                                Margin="2,0,0,0"
                                IsEnabled="{Binding CanRemove}"
                                Click="OnFrameRemoveClick" />

                        <!-- SpriteId label + duration editor -->
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding SpriteIdText}" FontSize="12" />
                            <NumericUpDown Value="{Binding DurationMs, Mode=TwoWay}"
                                           Minimum="1"
                                           Maximum="10000"
                                           Increment="10"
                                           Width="90"
                                           Height="22"
                                           FontSize="10"
                                           Padding="2,0" />
                        </StackPanel>

                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </DockPanel>
</UserControl>
