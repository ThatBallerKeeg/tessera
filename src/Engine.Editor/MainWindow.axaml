<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewport="clr-namespace:Engine.Editor.Viewport"
        xmlns:tilemap="clr-namespace:Engine.Editor.Tilemap"
        x:Class="Engine.Editor.MainWindow"
        Title="Tessera Engine Editor"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600">

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem x:Name="MenuNewScene"      Header="_New Scene" />
                <MenuItem x:Name="MenuOpenScene"     Header="_Open Scene..." />
                <MenuItem x:Name="MenuSaveScene"     Header="_Save Scene" />
                <Separator />
                <MenuItem x:Name="MenuImportTileset" Header="_Import Tileset..." />
                <Separator />
                <MenuItem x:Name="MenuExit"          Header="E_xit" />
            </MenuItem>
        </Menu>

        <!-- Five-panel layout: Left | Viewport | Tilemap tools | Inspector -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="120" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*"   MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="240" MinWidth="160" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="180" MinWidth="120" />
            </Grid.ColumnDefinitions>

            <!-- ── Left column: Scene (top) + Assets (bottom) ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"   MinHeight="100" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="180" MinHeight="80" />
                </Grid.RowDefinitions>

                <!-- Scene panel -->
                <Border Grid.Row="0" Padding="6">
                    <StackPanel>
                        <TextBlock Text="SCENE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Name:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBox x:Name="SceneNameBox" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <GridSplitter Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" />

                <!-- Assets panel -->
                <Border Grid.Row="2" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="ASSETS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4" />
                        <ListBox x:Name="AssetsList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Left vertical splitter -->
            <GridSplitter Grid.Column="1"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns" />

            <!-- ── Viewport panel ── -->
            <viewport:MonoGameViewport x:Name="MainViewport" Grid.Column="2" />

            <!-- Right vertical splitter (Viewport | Tilemap) -->
            <GridSplitter Grid.Column="3"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns" />

            <!-- ── Tilemap tools panel ── -->
            <tilemap:TilemapToolPanel x:Name="TilemapPanel" Grid.Column="4" />

            <!-- Right vertical splitter (Tilemap | Inspector) -->
            <GridSplitter Grid.Column="5"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns" />

            <!-- ── Inspector panel ── -->
            <Border Grid.Column="6" Padding="6">
                <StackPanel>
                    <TextBlock Text="INSPECTOR"
                               FontSize="10"
                               FontWeight="Bold" />
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
