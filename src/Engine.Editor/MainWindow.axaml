<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewport="clr-namespace:Engine.Editor.Viewport"
        xmlns:tilemap="clr-namespace:Engine.Editor.Tilemap"
        xmlns:animation="clr-namespace:Engine.Editor.Animation"
        x:Class="Engine.Editor.MainWindow"
        Title="Tessera Engine Editor"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600">

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem x:Name="MenuNewScene"      Header="_New Scene" />
                <MenuItem x:Name="MenuOpenScene"     Header="_Open Scene..." />
                <MenuItem x:Name="MenuSaveScene"     Header="_Save Scene" />
                <Separator />
                <MenuItem x:Name="MenuImportTileset"     Header="_Import Tileset..." />
                <MenuItem x:Name="MenuImportSpritesheet" Header="_Import Spritesheet (Aseprite JSON)..." />
                <Separator />
                <MenuItem x:Name="MenuLoadFixture"   Header="Load Test _Fixture" />
                <Separator />
                <MenuItem x:Name="MenuExit"          Header="E_xit" />
            </MenuItem>
        </Menu>

        <!-- Five-panel layout: Left | Viewport | Tool panels (Tilemap/Animation) | Inspector -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="120" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*"   MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="240" MinWidth="160" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="180" MinWidth="120" />
            </Grid.ColumnDefinitions>

            <!-- ── Left column: Scene (top) + Assets (bottom) ── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"   MinHeight="100" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="180" MinHeight="80" />
                </Grid.RowDefinitions>

                <!-- Scene panel -->
                <Border Grid.Row="0" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="SCENE"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4" />
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Name:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBox x:Name="SceneNameBox" />
                        </DockPanel>
                        <!-- GAME OBJECTS header + "+" button -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                            <Button DockPanel.Dock="Right"
                                    x:Name="BtnAddGameObject"
                                    Content="+"
                                    Width="20" Height="18"
                                    Padding="0" FontSize="12"
                                    VerticalAlignment="Center"
                                    Click="OnAddGameObject" />
                            <TextBlock Text="GAME OBJECTS"
                                       FontSize="10"
                                       Foreground="#888888"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- ListBox fills remaining space in the panel -->
                        <ListBox x:Name="GameObjectsList"
                                 MinHeight="40">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Padding="2,1" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" />

                <!-- Assets panel -->
                <Border Grid.Row="2" Padding="6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="ASSETS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4" />
                        <ListBox x:Name="AssetsList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Left vertical splitter -->
            <GridSplitter Grid.Column="1"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns" />

            <!-- ── Viewport panel (Play/Stop toolbar + MonoGame canvas) ── -->
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="4,2,4,2"
                            Spacing="4">
                    <Button x:Name="BtnPlayScene"
                            Content="▶ Play"
                            Width="64" Height="22"
                            Padding="0" FontSize="11"
                            Click="OnPlayScene" />
                    <Button x:Name="BtnStopScene"
                            Content="⏹ Stop"
                            Width="64" Height="22"
                            Padding="0" FontSize="11"
                            IsEnabled="False"
                            Click="OnStopScene" />
                </StackPanel>
                <viewport:MonoGameViewport x:Name="MainViewport" />
            </DockPanel>

            <!-- Right vertical splitter (Viewport | Tilemap) -->
            <GridSplitter Grid.Column="3"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns" />

            <!-- ── Tool panels: Tilemap and Animation share column 4 via tabs ──
                 Users author tilemaps or sprites at a given moment, not both
                 simultaneously, so a tab switcher is the natural fit.
                 ToolTabControl.SelectedIndex is set in code when an asset is
                 activated so the right panel jumps to the front automatically. -->
            <TabControl Grid.Column="4"
                        x:Name="ToolTabControl">
                <TabItem Header="Tilemap">
                    <tilemap:TilemapToolPanel x:Name="TilemapPanel" />
                </TabItem>
                <TabItem Header="Animation">
                    <animation:AnimationToolPanel x:Name="AnimationPanel" />
                </TabItem>
            </TabControl>

            <!-- Right vertical splitter (Tilemap | Inspector) -->
            <GridSplitter Grid.Column="5"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns" />

            <!-- ── Inspector panel ── -->
            <Border Grid.Column="6" Padding="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="INSPECTOR"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,4" />
                    <!-- Add Component — pinned to the bottom -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBlock Text="ADD COMPONENT"
                                   FontSize="9"
                                   Foreground="#888888"
                                   Margin="0,0,0,2" />
                        <ComboBox x:Name="AddComponentBox"
                                  IsEnabled="False"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnAddComponentSelected" />
                    </StackPanel>
                    <!-- Dynamic component list fills remaining space -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="InspectorContent" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
