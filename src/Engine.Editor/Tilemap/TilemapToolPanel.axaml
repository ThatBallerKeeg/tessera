<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Engine.Editor.Tilemap.TilemapToolPanel">
    <DockPanel>

        <!-- Header -->
        <TextBlock DockPanel.Dock="Top"
                   Text="TILEMAP"
                   FontSize="10"
                   FontWeight="Bold"
                   Margin="6,6,6,4" />

        <!-- Tileset row -->
        <DockPanel DockPanel.Dock="Top" Margin="6,2">
            <Button DockPanel.Dock="Right"
                    x:Name="LoadTilesetButton"
                    Content="..."
                    Width="28"
                    Margin="4,0,0,0"
                    ToolTip.Tip="Load tileset PNG" />
            <ComboBox x:Name="TilesetSelector"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="(no tileset)">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <!-- Layer row -->
        <DockPanel DockPanel.Dock="Top" Margin="6,2">
            <TextBlock DockPanel.Dock="Left"
                       Text="Layer"
                       VerticalAlignment="Center"
                       Width="36"
                       Margin="0,0,4,0" />
            <ComboBox x:Name="LayerSelector"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding LayerName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <!-- Tool buttons (mutually exclusive) -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="6,6,6,2">
            <ToggleButton x:Name="PaintToolButton"
                          Content="Paint"
                          IsChecked="True"
                          Width="56"
                          Margin="0,0,4,0" />
            <ToggleButton x:Name="EraseToolButton"
                          Content="Erase"
                          Width="56" />
        </StackPanel>

        <!-- Selected tile indicator -->
        <TextBlock DockPanel.Dock="Top"
                   x:Name="SelectedTileLabel"
                   Text="Selected: —"
                   Margin="6,4,6,4"
                   FontSize="11"
                   Foreground="#AAAAAA" />

        <Separator DockPanel.Dock="Top" Margin="0,2,0,4" />

        <!-- Palette (fills remaining vertical space) -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="PaletteGrid"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Image x:Name="PaletteImage"
                       Stretch="None"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
                <Canvas x:Name="SelectionCanvas"
                        IsHitTestVisible="False">
                    <Border x:Name="SelectionBorder"
                            BorderBrush="Yellow"
                            BorderThickness="2"
                            Background="Transparent"
                            IsVisible="False" />
                </Canvas>
            </Grid>
        </ScrollViewer>

    </DockPanel>
</UserControl>
