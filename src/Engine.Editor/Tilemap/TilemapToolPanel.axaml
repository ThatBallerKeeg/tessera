<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Engine.Editor.Tilemap.TilemapToolPanel">
    <DockPanel>

        <!-- Header -->
        <TextBlock DockPanel.Dock="Top"
                   Text="TILEMAP"
                   FontSize="10"
                   FontWeight="Bold"
                   Margin="6,6,6,4" />

        <!-- Tileset row -->
        <DockPanel DockPanel.Dock="Top" Margin="6,2">
            <Button DockPanel.Dock="Right"
                    x:Name="LoadTilesetButton"
                    Content="..."
                    Width="28"
                    Margin="4,0,0,0"
                    ToolTip.Tip="Load tileset PNG" />
            <ComboBox x:Name="TilesetSelector"
                      HorizontalAlignment="Stretch"
                      PlaceholderText="(no tileset)">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <!-- Layer row -->
        <DockPanel DockPanel.Dock="Top" Margin="6,2">
            <TextBlock DockPanel.Dock="Left"
                       Text="Layer"
                       VerticalAlignment="Center"
                       Width="36"
                       Margin="0,0,4,0" />
            <ComboBox x:Name="LayerSelector"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding LayerName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <!-- Layer management buttons -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="6,2,6,6">
            <Button x:Name="NewLayerButton"
                    Content="+"
                    Width="30"
                    Margin="0,0,2,0"
                    ToolTip.Tip="New layer" />
            <Button x:Name="DeleteLayerButton"
                    Content="Del"
                    Width="36"
                    Margin="0,0,2,0"
                    ToolTip.Tip="Delete active layer" />
            <Button x:Name="MoveUpButton"
                    Content="↑"
                    Width="30"
                    Margin="0,0,2,0"
                    ToolTip.Tip="Move layer up" />
            <Button x:Name="MoveDownButton"
                    Content="↓"
                    Width="30"
                    ToolTip.Tip="Move layer down" />
        </StackPanel>

        <!-- Tool buttons (mutually exclusive) -->
        <WrapPanel DockPanel.Dock="Top" Margin="6,6,6,2">
            <ToggleButton x:Name="PaintToolButton"  Content="Paint"  IsChecked="True" Width="56" Margin="0,0,4,4" />
            <ToggleButton x:Name="EraseToolButton"  Content="Erase"  Width="56" Margin="0,0,4,4" />
            <ToggleButton x:Name="FillToolButton"   Content="Fill"   Width="56" Margin="0,0,4,4" />
            <ToggleButton x:Name="RectToolButton"   Content="Rect"   Width="56" Margin="0,0,4,4" />
            <ToggleButton x:Name="LineToolButton"   Content="Line"   Width="56" Margin="0,0,4,4" />
            <ToggleButton x:Name="PickerToolButton" Content="Picker" Width="56" Margin="0,0,4,4" />
        </WrapPanel>

        <!-- Selected tile indicator -->
        <TextBlock DockPanel.Dock="Top"
                   x:Name="SelectedTileLabel"
                   Text="Selected: —"
                   Margin="6,4,6,4"
                   FontSize="11"
                   Foreground="#AAAAAA" />

        <Separator DockPanel.Dock="Top" Margin="0,2,0,4" />

        <!-- Palette (fills remaining vertical space).
             PaletteImage Width/Height are set in code to bitmap.PixelSize × PaletteScale (3×)
             so tiles are large enough to read and click.  Stretch="Fill" + BitmapInterpolationMode="None"
             gives crisp nearest-neighbour upscaling.  The Grid auto-sizes to the Image, and the
             ScrollViewer scrolls the 3× content when the panel is smaller.
             Because the Image has an explicit 3× display size, GetPosition(PaletteImage) returns
             display-pixel coords (0 … w*3), so hit-detection divides by PaletteScale before the
             tile-index calculation, and the SelectionBorder positions/sizes are multiplied by PaletteScale. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="PaletteGrid"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top">
                <Image x:Name="PaletteImage"
                       Stretch="Fill"
                       RenderOptions.BitmapInterpolationMode="None"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" />
                <Canvas x:Name="SelectionCanvas"
                        IsHitTestVisible="False">
                    <Border x:Name="SelectionBorder"
                            BorderBrush="Yellow"
                            BorderThickness="2"
                            Background="Transparent"
                            IsVisible="False" />
                </Canvas>
            </Grid>
        </ScrollViewer>

    </DockPanel>
</UserControl>
